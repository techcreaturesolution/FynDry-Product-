# Server Configuration
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database
MONGO_URI=mongodb://127.0.0.1:27017/fyndry

# JWT Configuration
JWT_ACCESS_SECRET=fyndry_super_secret_access_jwt_key_2026_dev
JWT_REFRESH_SECRET=fyndry_super_secret_refresh_jwt_key_2026_dev
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Seed Admin User
ADMIN_EMAIL=admin@fyndry.com
ADMIN_PASSWORD=Admin@FynDry

# Pricing Configuration
FREE_SHIPPING_THRESHOLD=499
FLAT_SHIPPING_FEE=49
GST_PERCENT=0

# Reverse Geocoding Configuration
GEO_PROVIDER=nominatim # nominatim | google
GOOGLE_MAPS_API_KEY=

# Payment Configuration (Razorpay INR)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
ENABLE_COD=true

# Email Configuration (Nodemailer / SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="FynDry <orders@fyndry.com>"

# Cloudinary (Image Hosting)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
